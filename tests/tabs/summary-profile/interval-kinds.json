    {
      "id": "ci_normal",
      "statistics": [
        "mean",
        "custom"
      ],
      "level": "confidence",
      "label": "{percent}% CI (normal)",
      "formula": "estimate ± normal_quantile((1+level)/2) × SE",
      "needs_design": false,
      "single_cell": true
    },
    {
      "id": "ci_t",
      "statistics": [
        "mean",
        "custom"
      ],
      "level": "confidence",
      "label": "{percent}% CI (t)",
      "formula": "estimate ± t_quantile((1+level)/2, df) × SE",
