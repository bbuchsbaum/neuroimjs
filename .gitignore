# NIfTI data files (large binaries — download separately)
*.nii
*.nii.gz
# ...except the small sample volume the docs site ships for its live demos.
!docs/public/data/*.nii.gz
# ...and the tiny nibabel conformance fixtures (npm run conformance:generate).
!tests/conformance/fixtures/nifti/*.nii
!tests/conformance/fixtures/nifti/*.nii.gz

# Playwright snapshots: only the Linux baselines are committed (CI renders on
# ubuntu-latest); other platforms' baselines stay local.
e2e/**/*-snapshots/*
!e2e/**/*-snapshots/*-linux.png

# Documentation site (VitePress + TypeDoc)
docs/.vitepress/dist/
docs/.vitepress/cache/
# docs/api/ is generated by TypeDoc on each build
docs/api/
