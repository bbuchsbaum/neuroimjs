{
  "name": "neuroimjs",
  "version": "0.2.0",
  "description": "A neuroimaging library for JavaScript — volumetric data, NIfTI I/O, spatial transforms, and WebGL orthogonal viewers",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/neuroimjs.es.js",
      "default": "./dist/neuroimjs.es.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/shoelace",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/testing/**",
    "!dist/**/test-migration/**"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:vite": "node scripts/clean-browser-build.mjs && vite build",
    "build:cjs": "tsc -p tsconfig.cjs.build.json && node scripts/write-cjs-package.mjs",
    "build:esm": "tsc -p tsconfig.esm.build.json && node scripts/fix-esm-imports.js",
    "build:types": "tsc -p tsconfig.types.build.json && node scripts/fix-esm-imports.js",
    "build:quick": "tsc -p tsconfig.cjs.build.json",
    "build:demo": "tsc -p tsconfig.build.json examples/orthogonal_slice_demo.ts --outDir dist/examples",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "test:specific": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:alignment": "vitest run src/display/__tests__/integration/MultiLayerAlignment",
    "test:debug": "vitest run --reporter=verbose --no-coverage",
    "lint": "eslint src tests",
    "lint:ci": "eslint src tests --max-warnings 608",
    "format": "prettier --write src tests",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run verify:release",
    "demo:ortho": "tsx examples/orthogonal_slice_demo.ts",
    "demo:extract": "tsx examples/extract_orthogonal_slices.ts",
    "demo:test-ortho": "tsx examples/test_orthogonal_slicing.ts",
    "demo:load": "tsx examples/load_image.ts",
    "demo:thumbs": "tsx examples/thumbnails.ts",
    "serve:examples": "npx http-server -c-1 .",
    "demo:simple-ortho": "npm run build:vite && npx http-server -c-1 . -o examples/umd/simple_orthogonal_viewer.html",
    "demo:single-view": "vite --open /examples/single-axial-view.html",
    "demo:two-view": "vite --open /examples/two-view-sync.html",
    "demo:multi-panel": "vite --open /examples/multi-panel-custom-layout.html",
    "demo:multi-layer": "vite --open /examples/multi-layer-viewer.html",
    "demo:overlay-review": "vite --open /examples/overlay-review-demo.html",
    "demo:composable": "vite --open /examples/composable-views-index.html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:package": "node scripts/verify-package.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify:release": "npm run test:types && npm run lint:ci && npm test -- --run --silent && npm run build && npm run build:vite && npm run check:bundle-size && npm run test:package && npm run docs:api && npm run audit:prod"
  },
  "keywords": [
    "neuroimaging",
    "nifti",
    "brain",
    "mri",
    "fmri",
    "volume",
    "webgl",
    "medical-imaging",
    "voxel"
  ],
  "author": "Bradley Buchsbaum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbuchsbaum/neuroimjs.git"
  },
  "homepage": "https://github.com/bbuchsbaum/neuroimjs",
  "bugs": {
    "url": "https://github.com/bbuchsbaum/neuroimjs/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "chroma-js": "^3.2.0",
    "lit": "^3.3.3",
    "mitt": "^3.0.1",
    "ml-matrix": "^6.15.0",
    "mobx": "^6.16.1",
    "nifti-reader-js": "^0.8.0",
    "nouislider": "^15.8.1",
    "pixi.js": "^8.20.0",
    "pako": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^20.19.0",
    "@types/pako": "^2.0.4",
    "autoprefixer": "^10.5.4",
    "canvas": "^3.2.3",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^26.0.0",
    "opencv-ts": "^1.3.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.41"
  },
  "type": "module"
}
