{
  "name": "neuroimjs",
  "version": "0.0.1",
  "description": "A neuroimaging library for JavaScript — volumetric data, NIfTI I/O, spatial transforms, and WebGL orthogonal viewers",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/neuroimjs.es.js"
    },
    "./browser": {
      "import": "./dist/neuroimjs.es.js",
      "require": "./dist/neuroimjs.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:vite": "vite build",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:quick": "tsc -p tsconfig.cjs.build.json",
    "build:demo": "tsc -p tsconfig.build.json examples/orthogonal_slice_demo.ts --outDir dist/examples",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "test:specific": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:alignment": "vitest run src/display/__tests__/integration/MultiLayerAlignment",
    "test:debug": "vitest run --reporter=verbose --no-coverage",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "prepublishOnly": "npm run build",
    "demo:ortho": "tsx examples/orthogonal_slice_demo.ts",
    "demo:extract": "tsx examples/extract_orthogonal_slices.ts",
    "demo:test-ortho": "tsx examples/test_orthogonal_slicing.ts",
    "demo:load": "tsx examples/load_image.ts",
    "demo:thumbs": "tsx examples/thumbnails.ts",
    "serve:examples": "npx http-server -c-1 .",
    "demo:simple-ortho": "npm run build:vite && npx http-server -c-1 . -o examples/umd/simple_orthogonal_viewer.html",
    "demo:single-view": "vite --open /examples/single-axial-view.html",
    "demo:two-view": "vite --open /examples/two-view-sync.html",
    "demo:multi-panel": "vite --open /examples/multi-panel-custom-layout.html",
    "demo:multi-layer": "vite --open /examples/multi-layer-viewer.html",
    "demo:composable": "vite --open /examples/composable-views-index.html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "keywords": [
    "neuroimaging",
    "nifti",
    "brain",
    "mri",
    "fmri",
    "volume",
    "webgl",
    "medical-imaging",
    "voxel"
  ],
  "author": "Bradley Buchsbaum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbuchsbaum/neuroimjs.git"
  },
  "homepage": "https://github.com/bbuchsbaum/neuroimjs",
  "bugs": {
    "url": "https://github.com/bbuchsbaum/neuroimjs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@lit/reactive-element": "^1.6.0",
    "@shoelace-style/shoelace": "^2.17.1",
    "@stdlib/ndarray": "^0.3.1",
    "axios": "^1.7.7",
    "buffer": "^6.0.3",
    "chroma-js": "^3.1.1",
    "lit": "^3.2.1",
    "lit-element": "^4.1.1",
    "lodash": "^4.17.21",
    "mobx": "^6.13.3",
    "nouislider": "^15.8.1",
    "pako": "^2.1.0",
    "pixi.js": "^8.4.1",
    "process": "^0.11.10",
    "split.js": "^1.6.5",
    "static-kdtree": "^1.0.2",
    "typed-emitter": "^2.1.0"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2",
    "opencv-ts": "^1.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/chroma-js": "^2.4.4",
    "@types/lodash": "^4.17.10",
    "@types/node": "^18.19.118",
    "@types/pako": "^2.0.3",
    "@types/pixi.js": "^4.8.9",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.14.2",
    "jsdom": "^26.0.0",
    "mitt": "^3.0.1",
    "ml-matrix": "^6.12.1",
    "nifti-reader-js": "^0.8.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "terser": "^5.32.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.4",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^3.0.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vitest": "^2.0.5"
  },
  "type": "module",
  "browser": "./dist/neuroimjs.es.js"
}
