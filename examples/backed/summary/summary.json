{
  "version": "0.1.0",
  "tables": {
    "effects": {
      "table": {
        "path": "summaries.csv",
        "format": "csv"
      },
      "statistic": "mean",
      "counting_unit": "subject",
      "unit": "percent_signal_change",
      "plot": {
        "mark": "point",
        "x": "condition",
        "order": {
          "condition": [
            "A",
            "B"
          ]
        }
      }
    },
    "regions": {
      "table": {
        "path": "regions.csv",
        "format": "csv"
      },
      "statistic": "mean",
      "counting_unit": "subject",
      "unit": "percent_signal_change",
      "plot": {
        "mark": "line",
        "x": "condition",
        "color": "group",
        "facet": "region",
        "order": {
          "condition": [
            "faces",
            "houses"
          ],
          "group": [
            "control",
            "patient"
          ]
        },
        "y_label": "\u03b2 (% signal change)"
      }
    }
  }
}